{
  "name": "cte-vizwiz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-runtime": "node ../scripts/fetch-runtime.mjs",
    "predev": "node ../scripts/fetch-runtime.mjs --if-missing",
    "prebuild": "node ../scripts/fetch-runtime.mjs --if-missing",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
